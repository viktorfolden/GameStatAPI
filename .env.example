# Copy these settings into your IDE run configuration or shell environment.
# Spring Boot does not load .env files automatically.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
DATABASE_URL=jdbc:postgresql://YOUR_DATABASE_HOST:5432/postgres?sslmode=verify-full
DATABASE_USERNAME=YOUR_SERVER_DATABASE_USER
DATABASE_PASSWORD=YOUR_DATABASE_PASSWORD
PORT=8080

# Python client only: a public key, never a secret key or service_role key.
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
GAME_API_URL=http://localhost:8080
